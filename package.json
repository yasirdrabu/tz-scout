{
  "name": "taazaa-scout",
  "version": "0.1.0",
  "private": true,
  "description": "Taazaa Scout",
  "scripts": {
    "dev": "next dev -p 4240",
    "build": "next build",
    "start": "next start -p 4240",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration --passWithNoTests",
    "test": "npm run test:unit && npm run test:int",
    "e2e": "playwright test",
    "db:migrate": "tsx src/entry/cli.ts db migrate",
    "scout": "tsx src/entry/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "next": "^15.5.28",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.4.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^3.2.7"
  }
}
