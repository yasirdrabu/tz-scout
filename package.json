{
  "name": "acq-system",
  "version": "0.1.0",
  "private": true,
  "description": "Taazaa client acquisition system",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db": "node scripts/db.mjs",
    "next:dev": "next dev -p 4240",
    "build": "next build",
    "start": "next start -p 4240",
    "postinstall": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:seed:sample": "tsx prisma/seed.ts",
    "db:reset:sample": "prisma db push --force-reset --skip-generate && tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "ci": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "jszip": "^3.10.1",
    "next": "^15.5.26",
    "next-auth": "^4.24.15",
    "pg-boss": "^10.4.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "unpdf": "^1.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "embedded-postgres": "^17.9.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "pg": "^8.23.1",
    "postcss": "^8.5.30",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@embedded-postgres/windows-x64@17.9.0-beta.17": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "engines": {
    "node": ">=22"
  }
}
