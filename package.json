{
  "name": "taazaa-scout",
  "version": "0.1.0",
  "private": true,
  "description": "Taazaa Scout",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/entry/cli.ts web",
    "build": "npm run build:web-ui && npm run build:api",
    "build:web-ui": "npm --prefix web-ui run build",
    "build:api": "tsup",
    "start": "node dist/cli.js web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration --passWithNoTests",
    "test": "npm run test:unit && npm run test:int",
    "e2e": "playwright test",
    "db:migrate": "tsx src/entry/cli.ts migrate",
    "scout": "tsx src/entry/cli.ts",
    "services:local": "node scripts/local-services.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@node-rs/argon2": "^2.2.2",
    "better-auth": "1.7.10",
    "cron-parser": "^5.10.2",
    "drizzle-orm": "^0.45.4",
    "exceljs": "4.4.0",
    "hono": "4.13.13",
    "i18n-iso-countries": "^7.14.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "tldts": "^7.4.19",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@typescript-eslint/parser": "^8.72.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.4.0",
    "jszip": "^3.10.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "8.71.2",
    "vitest": "^3.2.7"
  }
}
