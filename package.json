{
  "name": "taazaa-scout",
  "version": "0.1.0",
  "private": true,
  "description": "Taazaa Scout",
  "scripts": {
    "dev": "next dev -p 4240",
    "build": "next build && npm run build:server",
    "build:server": "tsup",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "start": "next start -p 4240",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration --passWithNoTests",
    "test": "npm run test:unit && npm run test:int",
    "e2e": "playwright test",
    "db:migrate": "tsx src/entry/cli.ts migrate",
    "scout": "tsx src/entry/cli.ts",
    "services:local": "node scripts/local-services.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@node-rs/argon2": "^2.2.2",
    "better-auth": "1.7.10",
    "cron-parser": "^5.10.2",
    "drizzle-orm": "^0.45.4",
    "exceljs": "4.4.0",
    "i18n-iso-countries": "^7.14.0",
    "next": "^15.5.28",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldts": "^7.4.19",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.4.0",
    "jszip": "^3.10.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^3.2.7"
  }
}
