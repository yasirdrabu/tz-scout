# development | test | production
NODE_ENV=development
# App database connection (runtime role, subject to row level security). Required in production.
DATABASE_URL=postgres://scout_app:scout_app@localhost:5432/scout
# Admin connection used only for migrations and bootstrap. Required in production.
DATABASE_ADMIN_URL=postgres://scout_admin:scout_admin@localhost:5432/scout
# Connections in the app database pool (per process). The worker keeps messages in flight below this. Default 20.
DATABASE_POOL_MAX=20
# Superuser connection. Only used to create the scout_app and scout_admin roles (src/platform/db/bootstrap.sql)
# and test databases. Compose creates the roles on first start; `npm run services:local` does the same.
# With docker compose use postgres://scout:scout@localhost:5432/postgres. Not required in production.
DATABASE_SUPERUSER_URL=postgres://postgres:postgres@localhost:5432/postgres
# NATS server with JetStream enabled. Required in production.
NATS_URL=nats://localhost:4222
# 32 random bytes, base64. Wraps credential data keys. Required in production.
SCOUT_MASTER_KEY=
# Previous master key, base64, kept during key rotation so old credentials still decrypt.
SCOUT_MASTER_KEY_PREVIOUS=
# Version stamped on credentials sealed with SCOUT_MASTER_KEY. The previous key is this number minus 1.
# Raise it by one each time you rotate the master key. Default 1.
SCOUT_MASTER_KEY_VERSION=1
# Secret used to sign sessions. Required in production.
AUTH_SECRET=
# Allow the dev sign-in form. Must be false in production.
AUTH_DEV_SIGNIN=true
# Force every provider to its mock adapter, even when credentials exist.
SCOUT_FORCE_MOCK=false
# Microsoft 365 sign-in. Set all three to enable it.
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
# Entra tenant ids (GUIDs, comma separated) whose people may be matched by email on their first sign-in.
# Defaults to AZURE_AD_TENANT_ID when that is a GUID. Platform admins match by email only from that home tenant.
AZURE_AD_ALLOWED_TENANT_IDS=
# Public base URL of the web app. Required in production.
APP_PUBLIC_URL=http://localhost:4240
# Log level: trace, debug, info, warn, error, silent.
LOG_LEVEL=info
