# App database connection (runtime role, subject to row level security).
DATABASE_URL=postgres://scout:scout@localhost:5432/scout
# Admin connection used only for migrations and bootstrap.
DATABASE_ADMIN_URL=postgres://scout:scout@localhost:5432/scout
# NATS server with JetStream enabled.
NATS_URL=nats://localhost:4222
# development | test | production
NODE_ENV=development
