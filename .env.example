# Database (local dev uses embedded Postgres on 5440, started by `npm run dev`)
DATABASE_URL="postgresql://acq:acq@localhost:5440/acq"
TEST_DATABASE_URL="postgresql://acq:acq@localhost:5440/acq_test"

# Auth
NEXTAUTH_URL="http://localhost:4240"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Public address of the app, for the "open in the acquisition system" link in HubSpot notes
APP_PUBLIC_URL="http://localhost:4240"
# Dev sign-in lists seeded users. Turn off before anyone outside the team can reach the app.
AUTH_DEV_SIGNIN="true"
# Microsoft 365 sign-in (Entra ID app registration). Leave blank to hide the button.
AZURE_AD_TENANT_ID=""
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""

# Integration modes: mock | live. Live needs the matching credentials below.
INTEGRATION_PROSPECTS="mock"
INTEGRATION_HUBSPOT="mock"
INTEGRATION_META="mock"
INTEGRATION_LINKEDIN="mock"
INTEGRATION_GOOGLE_ADS="mock"
INTEGRATION_COMPANY_DATA="mock"
INTEGRATION_BOOKING="mock"
INTEGRATION_MESSAGING="mock"
INTEGRATION_ANTHROPIC="mock"

# Mock timing: how many real seconds a mock ad test takes to "finish" (spec default is 72 hours)
MOCK_AD_TEST_SECONDS="20"

# Live credentials (unused while the matching mode is mock)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
APOLLO_API_KEY=""
# Most Apollo credits a single pull may spend (company search pages + enrichment + job and news pages)
APOLLO_MAX_CREDITS_PER_RUN="150"
HUBSPOT_PRIVATE_APP_TOKEN=""
HUBSPOT_PORTAL_ID="" # HubSpot account id, for "Open in HubSpot" links
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""
LINKEDIN_ACCESS_TOKEN=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""
COMPANY_DATA_API_KEY=""
BOOKING_URL_BASE="https://meetings.hubspot.com/"
MESSAGING_FROM_EMAIL=""

# Shared secret for inbound webhooks (form submissions, bookings)
WEBHOOK_SECRET="replace-me"
