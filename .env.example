# development | test | production
NODE_ENV=development
# Decides production behaviour (dev sign-in refusal, secure cookies, required secrets). Falls back to NODE_ENV.
# Needed because the image sets NODE_ENV=production. Set production on a VM, development on a laptop.
SCOUT_ENV=
# App database connection (runtime role, subject to row level security). Required in production.
DATABASE_URL=postgres://scout_app:scout_app@localhost:5432/scout
# Admin connection used only for migrations and bootstrap. Required in production.
DATABASE_ADMIN_URL=postgres://scout_admin:scout_admin@localhost:5432/scout
# Connections in the app database pool (per process). The worker keeps messages in flight below this. Default 20.
DATABASE_POOL_MAX=20
# Superuser connection. Only used to create the scout_app and scout_admin roles (src/platform/db/bootstrap.sql)
# and test databases. Compose creates the roles on first start; `npm run services:local` does the same.
# With docker compose use postgres://scout:scout@localhost:5432/scout (bootstrap.sql runs in the database it connects to). Not required in production.
DATABASE_SUPERUSER_URL=postgres://postgres:postgres@localhost:5432/scout
# NATS server with JetStream enabled. Required in production.
NATS_URL=nats://localhost:4222
# 32 random bytes, base64. Wraps credential data keys. Required in production.
SCOUT_MASTER_KEY=
# Previous master key, base64, kept during key rotation so old credentials still decrypt.
SCOUT_MASTER_KEY_PREVIOUS=
# Version stamped on credentials sealed with SCOUT_MASTER_KEY. The previous key is this number minus 1.
# Raise it by one each time you rotate the master key. Default 1.
SCOUT_MASTER_KEY_VERSION=1
# Secret used to sign sessions. Required in production.
AUTH_SECRET=
# Allow the dev sign-in form. Must be false in production.
AUTH_DEV_SIGNIN=true
# Force every provider to its mock adapter, even when credentials exist.
SCOUT_FORCE_MOCK=false
# Microsoft 365 sign-in. Set all three to enable it.
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
# Entra tenant ids (GUIDs, comma separated) whose people may be matched by email on their first sign-in.
# Defaults to AZURE_AD_TENANT_ID when that is a GUID. Platform admins match by email only from that home tenant.
AZURE_AD_ALLOWED_TENANT_IDS=
# Public base URL of the web app. Required in production.
APP_PUBLIC_URL=http://localhost:4240
# How many proxies in front of Scout append to X-Forwarded-For (a load balancer, a reverse proxy).
# Scout takes the client address that many entries from the right. 0 (default) ignores the header,
# so audit entries and API key "last used" have no IP; never set it higher than your real proxies.
SCOUT_TRUSTED_PROXY_HOPS=0
# Log level: trace, debug, info, warn, error, silent.
LOG_LEVEL=info
# Address the web server binds to. Default 0.0.0.0 (containers need this).
SCOUT_BIND_HOST=0.0.0.0
# --- Single VM stack (infra/compose/docker-compose.vm.yml) ---
# Image tag to run (git sha or latest).
IMAGE_TAG=latest
# Database passwords for the VM stack. Required there. They sit inside database URLs, so they must be
# URL-safe: generate each with "openssl rand -hex 32". Run compose with --env-file /opt/scout/.env.
POSTGRES_PASSWORD=
SCOUT_APP_DB_PASSWORD=
SCOUT_ADMIN_DB_PASSWORD=
# Offsite backups (optional). BACKUP_REMOTE is an rclone path on the remote named r2, e.g. r2:scout-backups.
# Leave empty to keep dumps on the VM only. The S3 settings below define that remote (Cloudflare R2 by default).
BACKUP_REMOTE=
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Cloudflare Tunnel token (profile tunnel only).
TUNNEL_TOKEN=
# Compose profile for the VM stack (VM only: tunnel or public-ip).
# COMPOSE_PROFILES=tunnel
